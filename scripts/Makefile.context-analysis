context-analysis-flags := -DWARN_CONTEXT_ANALYSIS		\
	-fexperimental-late-parse-attributes -Wthread-safety	\
	-Wthread-safety-pointer -Wthread-safety-beta

ifdef CONFIG_CC_HAS_CONTEXT_ANALYSIS
context-analysis-cflags := $(context-analysis-flags)

ifndef CONFIG_WARN_CONTEXT_ANALYSIS_ALL
context-analysis-cflags += --warning-suppression-mappings=$(srctree)/scripts/context-analysis-suppression.txt
endif

export CFLAGS_CONTEXT_ANALYSIS := $(context-analysis-cflags)
else ifdef CONFIG_CHECK_HAS_CONTEXT_ANALYSIS
export CHECKFLAGS_CONTEXT_ANALYSIS := $(context-analysis-flags)
endif
